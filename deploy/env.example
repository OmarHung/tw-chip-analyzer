# tw_chip_analyzer 環境變數範本。
# 複製到專案根目錄的 .env 並填值:  cp deploy/env.example .env  &&  chmod 600 .env
# pydantic-settings 會自動從專案根 .env 載入(見 app/core/config.py)。

# 環境:prod / dev 皆用 DATABASE_URL;只有 test 走 TEST_DATABASE_URL。
APP_ENV=prod

# PostgreSQL 連線(psycopg3 driver)。正式部署務必用強密碼。
# 注意:密碼直接寫在 URL 內,若含 URL 保留字元(@ : / # ? %)必須 percent-encode,
#       否則會解析錯誤(如 @ → %40、: → %3A)。最省事是用純英數密碼。
DATABASE_URL=postgresql+psycopg://twchip:__DB_PASSWORD__@localhost:5432/twchip

# 測試庫(部署主機通常不需要;跑 pytest 才用)
# TEST_DATABASE_URL=postgresql+psycopg://twchip:__DB_PASSWORD__@localhost:5432/twchip_test

# ops 回補端點(POST /api/ops/backfill)管理金鑰。經 nginx / tailscale 對外開放時務必設定,
# 否則只接受本機直連。產生:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# 前端「系統」頁觸發回補時輸入此金鑰(只存在該分頁的 sessionStorage)。
OPS_API_KEY=

# Telegram 推播(選用):EOD 完成後推「新進 BUY / AVOID」。兩者皆設才會送,留空=不推。
# 也可在網頁「設定」頁的 Telegram 卡片填寫(存 DB,優先於此處);此處留空即可。
# token 向 @BotFather 申請;chat id 可先對 bot 傳一則訊息,再開
#   https://api.telegram.org/bot<TOKEN>/getUpdates 取 message.chat.id(群組為負數)。
# 預覽不送:python -m app.jobs.notify_signals YYYY-MM-DD --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shioaji 逐筆行情(選用)。留空則 intraday 分項中性,不影響法人/背離/主力成本功能。
SJ_API_KEY=
SJ_SEC_KEY=
SJ_CA_PATH=
SJ_CA_PASSWD=

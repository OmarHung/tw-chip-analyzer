[Unit]
Description=tw_chip_analyzer Web (Next.js)
After=network.target twchip-api.service
Wants=twchip-api.service

[Service]
Type=simple
User=twchip
Group=twchip
WorkingDirectory=/home/twchip/tw_chip_analyzer/frontend
# 注意:NEXT_PUBLIC_API_BASE 於 `pnpm build` 時就烤進 client bundle。
# 這裡設同一個值供 SSR 使用;改網域必須重新 build 前端(見 deploy/README.md)。
Environment=NEXT_PUBLIC_API_BASE=https://__DOMAIN__
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/env pnpm start -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

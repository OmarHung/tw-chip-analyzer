# Docker Compose 用環境變數。複製到專案根目錄的 .env：
#   cp deploy/docker/env.example .env
# compose 會自動讀取根目錄 .env 做變數替換。
# (與 systemd 部署的 .env 不同:此處給 compose 用,不需 DATABASE_URL——
#  compose 會用 POSTGRES_PASSWORD 組出指向 db 服務的連線字串。)

# PostgreSQL 密碼(db 與 api 共用)。務必改成強密碼。
POSTGRES_PASSWORD=change-me-strong

# 前端 API 基底:設「公開網域」(瀏覽器同源、SSR 亦可連)。build 時烤入,改了要重 build。
# 本機測試可暫填 http://localhost:8000(個股 SSR 頁需域名可達才完整)。
NEXT_PUBLIC_API_BASE=https://your-domain

# Shioaji 逐筆行情(選用)。留空則 intraday 分項中性,不影響法人/背離/主力成本。
SJ_API_KEY=
SJ_SEC_KEY=
SJ_CA_PATH=
SJ_CA_PASSWD=

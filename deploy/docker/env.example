# Docker Compose 用環境變數。複製到專案根目錄的 .env：
#   cp deploy/docker/env.example .env
# compose 會自動讀取根目錄 .env 做變數替換。
# (與 systemd 部署的 .env 不同:此處給 compose 用,不需 DATABASE_URL——
#  compose 會用 POSTGRES_PASSWORD 組出指向 db 服務的連線字串。)

# PostgreSQL 密碼(db 與 api 共用)。務必改成強密碼。
# 可含任意特殊字元(@ : / 等):compose 用 PGPASSWORD 傳給 psycopg,不塞進 URL,不會壞。
POSTGRES_PASSWORD=change-me-strong

# 前端 API 基底(瀏覽器同源、SSR 亦可連)。build 時烤入,改了要重 build。
#   公開網域:  https://your-domain
#   Tailscale: https://<主機>.<tailnet>.ts.net   (見 deploy/tailscale.md)
#   本機測試:  http://localhost:8000            (個股 SSR 頁需位址可達才完整)
NEXT_PUBLIC_API_BASE=https://your-domain

# ops 回補端點管理金鑰。Docker 內未設定 → 系統頁回補一律 403(容器 client 非 loopback)。
# 產生:  python -c "import secrets;print(secrets.token_urlsafe(32))"
OPS_API_KEY=

# Telegram 推播(選用):EOD 完成後推「新進 BUY / AVOID」。兩者皆設才會送,留空=不推。
# 也可在網頁「設定」頁的 Telegram 卡片填寫(存 DB,優先於此處);此處留空即可。
# token 向 @BotFather 申請;chat id 可先對 bot 傳一則訊息,再開
#   https://api.telegram.org/bot<TOKEN>/getUpdates 取 message.chat.id(群組為負數)。
# 預覽不送:python -m app.jobs.notify_signals YYYY-MM-DD --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shioaji 逐筆行情(選用)。留空則 intraday 分項中性,不影響法人/背離/主力成本。
SJ_API_KEY=
SJ_SEC_KEY=
SJ_CA_PATH=
SJ_CA_PASSWD=
